{
  "name": "gebeta",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "build": "pnpm -r --filter ./engine run build",
    "test": "pnpm -r run test",
    "lint": "eslint \"**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
